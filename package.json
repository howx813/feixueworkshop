{
  "name": "feixue-workshop",
  "version": "0.2.41",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3456}",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "node scripts/build-export.mjs",
    "preview": "npm run build && npx --yes serve out -l 3457",
    "preview:out": "npx --yes serve out -l 3457",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "music:sync": "node scripts/sync-music.mjs",
    "tenders:sync": "node scripts/sync-tenders.mjs",
    "tenders:aggregate": "node scripts/aggregate-tenders.mjs",
    "tenders:weekly": "node scripts/weekly-bid-report.mjs",
    "tenders:weekly-site": "node scripts/weekly-site-report.mjs",
    "tenders:daily": "bash scripts/tenders-daily.sh",
    "analytics:sync": "node scripts/sync-analytics.mjs",
    "wechat:sync": "node scripts/sync-wechat-mp.mjs",
    "tenders:install-cron": "bash scripts/install-tenders-launchd.sh",
    "snowflake:export": "node scripts/export-snowflake-svg.mjs",
    "test": "npm run test:unit && npm run test:predeploy",
    "test:unit": "node scripts/test-marble.mjs && node scripts/test-aihot.mjs && node scripts/test-gravity.mjs && node scripts/test-pitch.mjs && node scripts/test-tender-history.mjs && node scripts/test-tender-aggregate.mjs && node scripts/test-weekly-report.mjs && node scripts/test-ai2048.mjs && node scripts/test-pagoda.mjs && node scripts/test-text-drop.mjs",
    "test:smoke": "node scripts/smoke-out.mjs",
    "test:predeploy": "node scripts/predeploy-check.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "version:print": "node scripts/version.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "release:from": "node scripts/release-from.mjs",
    "deploy:force": "echo '拒绝跳过测试。请用 npm run deploy' && exit 1",
    "pay:server": "node scripts/pay-server.mjs",
    "pay:confirm": "node scripts/pay-confirm.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
