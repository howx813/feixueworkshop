# 复制为 .env.local 后填写（.env.local 已被 gitignore）
NETEASE_APP_ID=
NETEASE_APP_SECRET=
NETEASE_PUBLIC_KEY=
NETEASE_PRIVATE_KEY=
# 可选：同步歌单到本地曲库
NETEASE_PLAYLIST_ID=

# 每日标讯（写在 .env.local，切勿提交账号密码）
# BXND_API_BASE=https://dgdata-api.bxnd.com.cn
# BXND_USERNAME=
# BXND_PASSWORD=
# BXND_TOKEN=            # 可选；不填则用账号密码自动登录
# BXND_PROVINCE_CODES=520000
# BXND_DAYS=14
# BXND_MAX_PAGES=5
# BXND_PAGE_SIZE=30
# 额外检索词（重点采购人/主题，逗号分隔）
# BXND_EXTRA_KEYWORDS=中电信人工智能,中电信人工智能科技有限公司

# 51la 网站统计 OpenAPI（/weekly 访问分析栏目；npm run analytics:sync）
# 在 https://v6.51.la/user/application/openapi 查看；免费配额 100 次/月
# LA51_ACCESS_KEY=
# LA51_SECRET_KEY=
# LA51_MASK_ID=          # 可选；不填则自动匹配 tcloudbaseapp 站点（多耗 1 次调用）

# 图像小说 · 本机服务（支付 + 任意文本生成 10 页）
# PAY_PORT=8787
# PAY_ADMIN_SECRET=请设一串足够长的随机密钥
# NEXT_PUBLIC_PAY_API=http://127.0.0.1:8787

# xAI（Grok）API：有密钥时 chat 拆节拍 + Imagine 出图；无密钥则 SVG 占位
# 在 https://console.x.ai 创建 API Key
# XAI_API_KEY=
# XAI_CHAT_MODEL=grok-4-1-fast-non-reasoning
# XAI_IMAGE_MODEL=grok-imagine-image

